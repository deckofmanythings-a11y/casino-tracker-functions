# Casino Session Tracker — backend config template. Copy to `.env` (git-ignored) and
# fill in from your NEW Discord application (Developer Portal). These are also set as
# Supabase function secrets on the shared raided-hex project via `supabase secrets set`.
#
# IMPORTANT: use the TRACKER_-prefixed names. raided-hex already owns the bare
# DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET secrets on this same project.

TRACKER_DISCORD_CLIENT_ID=
TRACKER_DISCORD_CLIENT_SECRET=

# Shared with raided-hex (already set on the project) — listed for reference only,
# do NOT re-set these:
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEYS
